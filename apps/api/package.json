{
  "name": "api",
  "version": "1.0.0",
  "description": "AI-Assisted IT Recruitment Platform — Express API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node -- src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "ts-node --esm prisma/seed.ts",
    "migrate": "prisma migrate dev",
    "migrate:reset": "prisma migrate reset",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@ai-repo/shared-types": "workspace:*",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.25.0",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "file-type": "^16.5.4",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.8.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.85.4",
    "pdf-parse": "^1.1.1",
    "prisma": "^5.22.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.19.41",
    "@types/pdf-parse": "^1.1.4",
    "@types/supertest": "^7.2.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
